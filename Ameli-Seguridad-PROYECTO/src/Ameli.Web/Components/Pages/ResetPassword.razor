@page "/restablecer"
@attribute [AllowAnonymous]
@inject SecurityApiClient Api
<PageTitle>Nueva contraseña | Ameli Creaciones</PageTitle>
<PageHeading Eyebrow="Recuperación de acceso" Title="Elige una nueva contraseña" Description="Al guardarla, se cerrarán tus sesiones anteriores." />
<section class="panel narrow-panel">
    @if (!ValidLink)
    { <div class="feedback error" role="alert">@(LinkError ?? "El enlace no es válido, ya se utilizó o expiró.")</div><a class="boton primario" href="/recuperar">Solicitar otro enlace</a> }
    else
    {
        <form method="post" action="/account/reset-password" class="formulario-apilado" data-password-confirm>
            <AntiforgeryToken /><input type="hidden" name="userId" value="@UserId" /><input type="hidden" name="token" value="@Token" />
            @if (Error is not null) { <div class="feedback error" role="alert">Revisa que la contraseña cumpla los requisitos y que ambas coincidan.</div> }
            <label for="new-password">Nueva contraseña<input id="new-password" name="password" type="password" required minlength="8" maxlength="64" autocomplete="new-password" aria-describedby="password-rules" /></label>
            <p class="help-text" id="password-rules">De 8 a 64 caracteres, con mayúscula, minúscula, número y símbolo.</p>
            <label for="confirm-password">Confirmar contraseña<input id="confirm-password" name="confirmPassword" type="password" required minlength="8" maxlength="64" autocomplete="new-password" /></label>
            <button type="submit" class="boton primario" data-pending="Guardando…">Guardar contraseña</button>
        </form>
    }
</section>
@code {
    [SupplyParameterFromQuery(Name = "userId")] public string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private bool ValidLink;
    private string? LinkError;
    protected override async Task OnParametersSetAsync()
    {
        ValidLink = false;
        if (string.IsNullOrWhiteSpace(Token) || Token.Length > 128 || !Guid.TryParse(UserId, out var id) || Error == "enlace") return;
        try
        {
            await Api.AnonymousAsync<ApiMessage>("auth/validate-reset", new ValidateResetRequest { UserId = id, Token = Token });
            ValidLink = true;
        }
        catch (ApiFault ex) { LinkError = ex.Message; }
    }
}
