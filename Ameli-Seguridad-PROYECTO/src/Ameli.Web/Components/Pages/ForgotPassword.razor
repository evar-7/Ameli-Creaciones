@page "/recuperar"
@attribute [AllowAnonymous]
<PageTitle>Recuperar acceso | Ameli Creaciones</PageTitle>
<PageHeading Eyebrow="Recuperación de acceso" Title="Volvamos a tu cuenta" Description="Te ayudamos a restablecer tu contraseña." />
<div class="acceso-grid">
    <section class="panel auth-panel">
        <div class="auth-heading"><span class="auth-step">RECUPERAR CONTRASEÑA</span><h2>¿Olvidaste tu contraseña?</h2><p>Escribe el correo que utilizas en Ameli.</p></div>
        <form method="post" action="/account/forgot-password" class="formulario-apilado auth-form">
            <AntiforgeryToken />
            @if (State == "enviado") { <div class="feedback success" role="status">Si la cuenta puede recuperar el acceso, recibirás instrucciones en tu correo.</div> }
            @if (Error is not null) { <div class="feedback error" role="alert">Escribe un correo electrónico válido.</div> }
            <label for="recovery-email">Correo electrónico<input id="recovery-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="nombre@correo.com" /></label>
            <button class="boton primario ancho" type="submit" data-pending="Enviando…">Enviar instrucciones</button>
            <a class="boton secundario ancho" href="/ingresar">Volver al ingreso</a>
            <p class="mensaje-seguridad">El enlace dura 15 minutos y solo se puede utilizar una vez.</p>
        </form>
    </section><RoleSummary />
</div>
@code {
    [SupplyParameterFromQuery(Name = "estado")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
}
